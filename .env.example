# Shopify Storefront API (optional — site falls back to local seed catalog when absent)
# Create a custom app in Shopify admin → Storefront API access token.
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# Public site URL (used for metadata / sitemap)
NEXT_PUBLIC_SITE_URL=https://deprisbeauty.com
